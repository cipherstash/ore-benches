# Copy to .env.local and fill in. The harness reads these at server start.

# --- shared ---
DATABASE_URL=postgres://postgres:postgres@localhost:5400/postgres
# Which backend the server encrypts/decrypts with:
#   zerokms | aws-kms | aws-kms-envelope
ENCRYPTION_BACKEND=zerokms

# --- ZeroKMS (CipherStash Encryption SDK) ---
# Local runs use your CipherStash profile from `stash login` (~/.cipherstash/).
# NO env vars needed — the SDK/FFI reads the profile automatically, the same way
# the AWS backends use your AWS SSO session.
#
# For headless/CI only (no profile available), the FFI also accepts:
#   CS_WORKSPACE_CRN
#   CS_CLIENT_ID
#   CS_CLIENT_KEY
#   CS_CLIENT_ACCESS_KEY

# --- AWS KMS (used by both aws-kms and aws-kms-envelope) ---
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
# AWS credentials are picked up from the standard provider chain
# (AWS_PROFILE / env vars / instance role).

# aws-kms-envelope only. Default 1 = a fresh data key per value (per-value KMS
# mediation — the fair, equal-security comparison vs ZeroKMS). Values > 1 enable
# data-key caching: faster, but a WEAKER security model (one key covers many
# records; you lose per-value audit/revocation). Don't use caching for fair
# comparisons — only to demonstrate the trade-off.
ENVELOPE_DATA_KEY_MAX_USES=1
