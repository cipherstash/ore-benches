# Copy to .env.local and fill in. The harness reads these at server start.

# --- shared ---
DATABASE_URL=postgres://postgres:postgres@localhost:5400/postgres
# Which backend the server encrypts/decrypts with:
#   zerokms | aws-kms | aws-kms-envelope
ENCRYPTION_BACKEND=zerokms

# --- ZeroKMS (CipherStash Encryption SDK) ---
# From your CipherStash workspace. See https://cipherstash.com/docs
CS_WORKSPACE_CRN=
CS_CLIENT_ID=
CS_CLIENT_KEY=
CS_CLIENT_ACCESS_KEY=

# --- AWS KMS (used by both aws-kms and aws-kms-envelope) ---
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
# AWS credentials are picked up from the standard provider chain
# (AWS_PROFILE / env vars / instance role).

# aws-kms-envelope only: values encrypted per cached data key before calling
# GenerateDataKey again. Higher = fewer KMS calls. Set to 1 to force a KMS
# call per value (closest to the naive aws-kms backend).
ENVELOPE_DATA_KEY_MAX_USES=1000
